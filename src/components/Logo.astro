---
import { site } from "../data/site";
interface Props {
  label?: string;
  href?: string;
}
const { label, href = "#top" } = Astro.props;
---

<a
  href={href}
  class="logo inline-flex min-h-11 items-center gap-2.5 text-2xl leading-none font-bold tracking-[-0.04em]"
  aria-label={label}
>
  <svg
    width="35"
    height="35"
    viewBox="0 0 35 35"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect width="35" height="35" rx="5" fill="#E55B2A" />
    <path
      d="M5.94391 24V9.94H7.86391L13.5639 19.06H12.4639L18.1439 9.94H20.0639V24H17.3639V14.6L17.8839 14.76L13.9239 21.12H12.0839L8.12391 14.76L8.66391 14.6V24H5.94391Z"
      fill="white"
    />
    <path
      d="M20.8293 24V21.58H24.4093C25.316 21.58 26.1093 21.3933 26.7893 21.02C27.4693 20.6333 27.996 20.0933 28.3693 19.4C28.756 18.7067 28.9493 17.8867 28.9493 16.94C28.9493 16.02 28.756 15.22 28.3693 14.54C27.9826 13.8467 27.4493 13.3133 26.7693 12.94C26.0893 12.5533 25.3026 12.36 24.4093 12.36H20.7693V9.94H24.4493C25.4893 9.94 26.4493 10.1133 27.3293 10.46C28.2226 10.8067 28.996 11.3 29.6493 11.94C30.316 12.5667 30.8293 13.3067 31.1893 14.16C31.5626 15.0133 31.7493 15.9467 31.7493 16.96C31.7493 17.9733 31.5626 18.9133 31.1893 19.78C30.8293 20.6333 30.3226 21.38 29.6693 22.02C29.016 22.6467 28.2426 23.1333 27.3493 23.48C26.4693 23.8267 25.516 24 24.4893 24H20.8293ZM18.9693 24V9.94H21.6893V24H18.9693Z"
      fill="white"
    />
  </svg>

  {site.name}
</a>
