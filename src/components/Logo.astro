---
import { site } from '../data/site'
interface Props {
  label?: string
  href?: string
}
const { label, href = '#top' } = Astro.props
---

<a href={href} class="logo inline-flex items-center gap-2.5 text-2xl leading-none font-bold tracking-[-0.04em]" aria-label={label}>
  <svg class="size-[26px]" viewBox="0 0 26 26" aria-hidden="true">
    <rect width="26" height="26" rx="7" fill="#e8480c"></rect>
    <path d="M5 17c5 0 5-8 10-8s3 8 6 0" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path>
  </svg>
  {site.name}
</a>
