---
import { copy } from '../data/copy'
import type { Lang } from '../data/site'

interface Props {
  lang: Lang
}
const { why } = copy[Astro.props.lang]
---

<section class="pt-section" id="why" aria-label={why.label}>
  <div class="wrap reveal">
    <p class="max-w-[44ch] text-[clamp(1.5rem,3.2vw,2.5rem)] leading-[1.3] tracking-[-0.02em] text-pretty text-ink">
      {why.lead}
    </p>
  </div>
  <div class="wrap mt-[clamp(40px,6vw,72px)]">
    <ul class="grid border-t border-line lg:grid-cols-3">
      {why.problems.map(([name, text], i) => (
        <li class="reveal grid content-start gap-3.5 border-line py-7 not-first:border-t lg:py-9 lg:pr-7 lg:not-first:border-t-0 lg:not-first:border-l lg:not-first:pl-7" style={`--i:${i}`}>
          <h3>{name}</h3>
          <p class="text-muted">{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
