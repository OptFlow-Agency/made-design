---
import { copy } from '../data/copy'
import { site, type Lang } from '../data/site'

interface Props {
  lang: Lang
}
const c = copy[Astro.props.lang].contact
---

<section class="mt-section bg-dark py-section text-white" id="contact" aria-labelledby="contact-title">
  <div class="wrap grid items-start gap-[clamp(40px,7vw,112px)] lg:grid-cols-[1fr_1.4fr]">
    <div class="reveal">
      <h2 id="contact-title" class="max-w-[12ch] text-[clamp(2.5rem,7vw,5rem)] lg:max-w-[8ch]">{c.title}</h2>
      <p class="lead mt-6 text-dark-muted">{c.lead}</p>
      <p class="mt-8 text-dark-muted">{c.fallback}</p>
      <a class="mt-2 inline-block border-b-2 border-accent pb-1.5 font-mono text-xl leading-none font-semibold" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    {site.calLink && (
      <div class="reveal min-h-[600px] overflow-hidden rounded-[20px] bg-white" style="--i:1">
        <div id="cal-embed" class="h-full w-full" data-cal-link={site.calLink}></div>
      </div>
    )}
  </div>
</section>

{site.calLink && (
  <script is:inline>
    ;(function (C, A, L) {
      let p = function (a, ar) { a.q.push(ar) }
      let d = C.document
      C.Cal = C.Cal || function () {
        let cal = C.Cal
        let ar = arguments
        if (!cal.loaded) {
          cal.ns = {}
          cal.q = cal.q || []
          d.head.appendChild(d.createElement('script')).src = A
          cal.loaded = true
        }
        if (ar[0] === L) {
          const api = function () { p(api, arguments) }
          const namespace = ar[1]
          api.q = api.q || []
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api
            p(cal.ns[namespace], ar)
            p(cal, ['initNamespace', namespace])
          } else p(cal, ar)
          return
        }
        p(cal, ar)
      }
    })(window, 'https://app.cal.com/embed/embed.js', 'init')
    Cal('init', { origin: 'https://app.cal.com' })
    var el = document.getElementById('cal-embed')
    Cal('inline', {
      elementOrSelector: el,
      calLink: el.dataset.calLink,
      layout: 'month_view',
      config: { layout: 'month_view', theme: 'light' },
    })
    Cal('ui', { theme: 'light', hideEventTypeDetails: false, layout: 'month_view' })
  </script>
)}
