---
import AuroraCurtain from './AuroraCurtain.astro'
import { copy } from '../data/copy'
import type { Lang } from '../data/site'

interface Props {
  lang: Lang
}
const { hero: c } = copy[Astro.props.lang]

---

<section class="relative isolate flex items-start overflow-hidden pt-[clamp(56px,10vw,128px)] pb-[clamp(72px,10vw,140px)] md:min-h-[min(86svh,860px)] md:items-center" aria-labelledby="hero-title">
  <AuroraCurtain
    class="-z-10"
    colors={['#e8480c', '#ff8a4c', '#ffb347']}
    bands={4}
    blur={0.55}
    intensity={0.7}
    speed={0.8}
  />
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-linear-to-b from-transparent to-white" aria-hidden="true"></div>
  <div class="wrap relative z-[2] text-center">
    <h1 id="hero-title" class="mx-auto max-w-[14ch]">{c.before}<em class="text-accent not-italic">{c.em}</em>{c.after}</h1>
    <p class="lead mx-auto mt-7">{c.lead}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3.5">
      <a href="#contact" class="btn btn-primary max-md:flex-[1_1_100%]">
        {c.cta}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a href="#formats" class="btn btn-ghost max-md:flex-[1_1_100%]">{c.ghost}</a>
    </div>
  </div>
</section>
