---
import { Image } from 'astro:assets'
import { copy } from '../data/copy'
import { site, type Lang } from '../data/site'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const c = copy[lang].studio
const f = site.founder

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.{png,jpg,jpeg,webp,avif}', { eager: true })
const photo = f.photo ? photos[`../assets/team/${f.photo}`]?.default : undefined
const role = f.role[lang]
const bio = f.bio[lang]
---

<section class="pt-section" id="studio" aria-labelledby="studio-title">
  <div class="wrap grid gap-[clamp(32px,5vw,72px)] lg:grid-cols-[1fr_1.4fr]">
    <h2 id="studio-title" class="reveal">{c.title}</h2>
    <div class="reveal grid gap-8" style="--i:1">
      <p class="max-w-[52ch] text-[clamp(1.125rem,2vw,1.375rem)] leading-normal text-ink">{c.body}</p>
      {f.name && (
        <div class="flex flex-wrap items-center gap-5">
          {photo && <Image src={photo} alt={c.photoAlt(f.name)} width={160} height={160} class="size-20 rounded-full object-cover" />}
          <div>
            <p class="text-xl font-medium">{f.name}</p>
            {role && <p class="font-mono text-[0.8125rem] tracking-[0.06em] text-muted uppercase">{role}</p>}
          </div>
          {bio && <p class="max-w-[52ch] basis-full text-muted">{bio}</p>}
        </div>
      )}
    </div>
  </div>
</section>
