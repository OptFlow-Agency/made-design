---
import { Image } from "astro:assets";
import { copy } from "../data/copy";
import { formatDate, postHref, type Post } from "../data/blog";
import type { Lang } from "../data/site";

interface Props {
  lang: Lang;
  post: Post;
}
const { lang, post } = Astro.props;
const c = copy[lang].blog;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/blog/*.{png,jpg,jpeg,webp,avif,svg}",
  { eager: true },
);
const cover = images[`../assets/blog/${post.cover}`]?.default;
---

<a class="group/post block" href={postHref(lang, post.slug)}>
  <div class="relative aspect-[16/9] overflow-hidden rounded-sm bg-surface ring-1 ring-line ring-inset">
    {cover && (
      <Image
        src={cover}
        alt=""
        widths={[480, 720, 1080]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="size-full object-cover transition-transform duration-700 ease-snap group-hover/post:scale-[1.03]"
      />
    )}
  </div>
  <p class="mt-5 font-mono text-[0.8125rem] tracking-[0.06em] text-muted uppercase">
    <time datetime={post.date}>{formatDate(post.date, lang)}</time> · {post.minutes} {c.minutes}
  </p>
  <h3 class="mt-3 underline-offset-[6px] group-hover/post:underline">{post.title[lang]}</h3>
  <p class="mt-3 max-w-[52ch] text-muted">{post.excerpt[lang]}</p>
  <span class="mt-5 inline-flex items-center gap-2 text-[1rem] font-medium">
    {c.read}
    <svg class="size-4 transition-transform duration-300 ease-snap group-hover/post:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </span>
</a>
