---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
import { copy } from '../data/copy'
import { locales, pathFor, site, type Lang } from '../data/site'
import { organization, website } from '../data/schema'

interface Props {
  lang: Lang
  title?: string
  description?: string
  /** Path of this page in each language (defaults to the home page). */
  paths?: Record<Lang, string>
  type?: 'website' | 'article'
  /** Extra JSON-LD blocks for this page (the organization and website are always included). */
  schema?: Record<string, unknown>[]
  /** Keep the page out of search results and skip canonical/hreflang (e.g. the 404). */
  noindex?: boolean
}

const { lang, type = 'website', schema = [], noindex = false } = Astro.props
const paths = Astro.props.paths ?? { fr: pathFor('fr'), en: pathFor('en') }
const title = Astro.props.title ?? copy[lang].meta.title
const description = Astro.props.description ?? copy[lang].meta.description
// hreflang and canonical need absolute URLs: set `site` in astro.config.mjs.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path)
const origin = Astro.site?.origin
const jsonLd = origin ? [organization(origin, lang), website(origin, lang), ...schema] : []
// '<' is escaped so the JSON can never close the script tag.
const serialize = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_MA' : 'en_US'} />
    <meta property="og:site_name" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && (
      <>
        <meta property="og:url" content={abs(paths[lang])} />
        <link rel="canonical" href={abs(paths[lang])} />
        {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(paths[l])} />)}
        <link rel="alternate" hreflang="x-default" href={abs(paths.fr)} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={serialize(data)} />)}
    <Analytics />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/smooth-scroll'
    </script>
  </body>
</html>
