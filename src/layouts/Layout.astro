---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
import { copy } from '../data/copy'
import { locales, pathFor, type Lang } from '../data/site'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { title, description } = copy[lang].meta
// hreflang and canonical need absolute URLs: set `site` in astro.config.mjs.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_MA' : 'en_US'} />
    <link rel="canonical" href={abs(pathFor(lang))} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(pathFor(l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(pathFor('fr'))} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    <Analytics />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/smooth-scroll'
    </script>
  </body>
</html>
