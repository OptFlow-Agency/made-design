---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { pathFor } from '../data/site'

export const prerender = true
---

<Layout lang="fr" title="Page introuvable — Made Design" description="Cette page n’existe pas ou a été déplacée." noindex>
  <Header lang="fr" base={pathFor('fr')} />
  <main id="main" class="pt-[clamp(64px,10vw,128px)] pb-section">
    <div class="wrap">
      <p class="font-mono text-[0.8125rem] tracking-[0.06em] text-muted uppercase">404</p>
      <h1 class="mt-4 max-w-[18ch] text-[clamp(2.5rem,7vw,5rem)]">Cette page est introuvable.</h1>
      <p class="lead mt-4 max-w-[52ch]">Elle a peut-être été déplacée. Revenez à l’accueil ou lisez le blog.</p>
      <p class="mt-8 flex flex-wrap gap-x-6 gap-y-3 font-mono text-[0.9375rem] font-medium">
        <a class="underline underline-offset-4" href="/">Accueil</a>
        <a class="underline underline-offset-4" href="/blog/">Le blog</a>
        <a class="underline underline-offset-4" href="/en/">English</a>
      </p>
    </div>
  </main>
  <Footer lang="fr" base={pathFor('fr')} />
</Layout>
